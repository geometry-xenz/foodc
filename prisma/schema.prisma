generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String          @id @default(cuid())
  email        String          @unique
  passwordHash String
  name         String          @default("Chef")
  createdAt    DateTime        @default(now())
  profile      Profile?
  pantry       PantryItem[]
  goal         Goal?
  mealPlan     MealPlanEntry[]
}

model Profile {
  id             String   @id @default(cuid())
  userId         String   @unique
  age            Int      @default(26)
  heightCm       Float    @default(175)
  weightKg       Float    @default(70)
  targetWeightKg Float    @default(70)
  sex            String   @default("male")
  activityLevel  String   @default("moderate")
  diet           String   @default("any")
  allergies      String   @default("[]")
  excluded       String   @default("[]")
  units          String   @default("metric")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PantryItem {
  id          String   @id @default(cuid())
  userId      String
  name        String
  displayName String
  category    String   @default("Spices")
  quantity    Float    @default(100)
  unit        String   @default("g")
  isAvailable Boolean  @default(true)
  source      String   @default("manual")
  confidence  Float    @default(1)
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId])
}

model Ingredient {
  id          String             @id @default(cuid())
  name        String             @unique
  displayName String
  category    String
  calories    Float
  protein     Float
  carbs       Float
  fat         Float
  fibre       Float
  sugar       Float              @default(0)
  sodiumMg    Float              @default(0)
  saturatedFat Float             @default(0)
  ironMg      Float              @default(0)
  calciumMg   Float              @default(0)
  vitaminCMg  Float              @default(0)
  compounds   IngredientCompound[]
  recipes     RecipeIngredient[]
}

model FlavorCompound {
  id          String             @id @default(cuid())
  name        String             @unique
  family      String             @default("Volatile")
  description String             @default("")
  ingredients IngredientCompound[]
}

model IngredientCompound {
  id           String         @id @default(cuid())
  ingredientId String
  compoundId   String
  ingredient   Ingredient     @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  compound     FlavorCompound @relation(fields: [compoundId], references: [id], onDelete: Cascade)

  @@unique([ingredientId, compoundId])
}

model Recipe {
  id               String             @id
  title            String
  cuisine          String
  diet             String
  mealType         String             @default("lunch")
  prepTimeMinutes  Int
  cookTimeMinutes  Int
  totalTimeMinutes Int
  servings         Int
  imageUrl         String
  instructions     String
  coreIngredients  String
  dominantAroma    String
  coherenceScore   Float
  pairingNotes     String
  calories         Float
  protein          Float
  carbs            Float
  fat              Float
  fibre            Float
  ingredients      RecipeIngredient[]
}

model RecipeIngredient {
  id           String     @id @default(cuid())
  recipeId     String
  ingredientId String
  name         String
  displayName  String
  quantity     Float
  unit         String
  isCore       Boolean    @default(false)
  recipe       Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])
}

model Goal {
  id              String @id @default(cuid())
  userId          String @unique
  primaryGoal     String @default("lean_bulk")
  targetCalories  Float
  targetProteinG  Float
  targetCarbsG    Float
  targetFatG      Float
  targetFibreG    Float
  user            User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MealPlanEntry {
  id        String   @id @default(cuid())
  userId    String
  date      String
  mealType  String
  recipeId  String
  servings  Float    @default(1)
  calories  Float
  protein   Float
  carbs     Float
  fat       Float
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}
