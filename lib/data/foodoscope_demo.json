    {
      "Recipe_id": "demo-001",
      "Recipe_title": "Hyderabadi Chicken Dum Biryani",
      "cuisine": "Hyderabadi",
      "region": "Indian",
      "total_time": "90",
      "diet": "non-vegetarian",
      "utensils": "pot frypan",
      "ingredients": [
        "basmati rice",
        "chicken",
        "yogurt",
        "onion",
        "mint",
        "coriander",
        "ginger",
        "garlic",
        "green chilli",
        "saffron",
        "ghee",
        "cardamom",
        "cinnamon",
        "bay leaf",
        "cumin",
        "lemon",
        "salt"
      ],
      "instructions": [
        "Marinate chicken in yogurt, ginger-garlic paste, chilli, mint, coriander and half the fried onions for 4 hours.",
        "Soak basmati rice for 30 minutes; parboil with cardamom, cinnamon, bay leaf and salt until 70% done.",
        "Layer marinated chicken, rice, saffron milk, ghee and fried onions in a heavy pot.",
        "Seal the pot with dough and cook on low dum for 25 minutes.",
        "Rest 10 minutes, open, and fold gently before serving."
      ]
    },
