# DRISHYAM Root Environment Configuration (.env.example)
# Copy to .env and configure for local development or production.

# Web App Configuration
NEXT_PUBLIC_API_URL=
PORT=
NODE_ENV=

# Production Reverse Proxy Hostname
CADDY_HOST=

# Database Connection (FastAPI backend + Next.js if direct)
DATABASE_URL=
TEST_DATABASE_URL=

# Cryptographic Keys & Secrets
SECRET_KEY=
JWT_SECRET=

# External Integrations (Optional)
FOODOSCOPE_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=
FDC_API_KEY=
SMTP_URL=

# Android Release Keystore (Production Signing Only)
DRISHYAM_KEYSTORE_PATH=
DRISHYAM_KEYSTORE_PASSWORD=
DRISHYAM_KEY_ALIAS=
DRISHYAM_KEY_PASSWORD=
